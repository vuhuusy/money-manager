# Copy this file to .env and fill in the values
# cp .env.example .env

# ── MariaDB ───────────────────────────────────────────────
MYSQL_DB=moneymanager
MYSQL_DB_USERNAME=moneymanager
MYSQL_DB_PASSWORD=change_me_db_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# ── JWT ───────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=change_me_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRATION_MS=86400000

# ── Mail (SMTP) ───────────────────────────────────────────
# Example for Gmail: use an App Password, not your real password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your@gmail.com

# ── Public URL ────────────────────────────────────────────
# Your Cloudflare tunnel public hostname (no trailing slash)
APP_URL=https://your-domain.example.com

# ── Cloudflare Tunnel ─────────────────────────────────────
# Get this token from: Cloudflare Zero Trust → Networks → Tunnels
# Create a tunnel, then copy the token from the install command
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here
